        <mxCell id="v3Tol91V-TR1hirwzvUr-230" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=23;" value="High Level Workflow" vertex="1">
          <mxGeometry height="770" width="800" x="870" y="2220" as="geometry" />
