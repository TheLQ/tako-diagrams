        <mxCell id="O7RtcG87wgtdWtwiXMiO-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Page 2&lt;/div&gt;&lt;div&gt;Overview&lt;/div&gt;B" vertex="1">
          <mxGeometry height="60" width="80" as="geometry" />
        </mxCell>
        <mxCell id="IUKe4zq0TAK9BhHKJ35b-4" parent="1" style="verticalLabelPosition=middle;verticalAlign=middle;html=1;shape=mxgraph.basic.tick;labelPosition=right;align=left;fontSize=16;fillColor=#FF0000;" value="Also a full mega-base" vertex="1">
          <mxGeometry height="38" width="31" x="590" y="170" as="geometry" />
        </mxCell>
        <mxCell id="oS6NGQJdLx5hrXchkMkH-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;facto-loop-miner&#39;s primary niche is Pathfinding a &lt;b&gt;Rail Network&lt;/b&gt; between disparate &lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;Ore Patches&lt;/span&gt; and a central&amp;nbsp;&lt;b&gt;Base&lt;/b&gt;. The secondary niche is as&amp;nbsp;&lt;/div&gt;&lt;div&gt;an automatic&amp;nbsp;&lt;b&gt;Base&amp;nbsp;&lt;/b&gt;generator with the goal of&amp;nbsp;&lt;b&gt;megabase&lt;/b&gt;-scale&amp;nbsp;benchmark-setting runs. We are automatically playing the game through all required resource combinations to obtain the end-goal objective (launching a &lt;span style=&quot;color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot;&gt;Rocket&lt;/span&gt;) with an extremely large &lt;b&gt;Base&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;We generate the &lt;b&gt;Rail Network&lt;/b&gt;&amp;nbsp;assuming&lt;ul&gt;&lt;li&gt;Rails are a fun way to move Ore vs Belts&lt;/li&gt;&lt;li&gt;Rail with intersections are slow. Even with advanced techniques, they are slower than a loop of rail without intersections&lt;/li&gt;&lt;li&gt;Loops between Ore Patch and Offload should be as short as possible&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="435" x="125" as="geometry" />
        </mxCell>
        <mxCell id="eCBUhFV-2yNepO3pzQtW-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="facto-loop-miner Module Tree" vertex="1">
