<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:145.0) Gecko/20100101 Firefox/145.0" pages="9">
  <diagram id="a_DEHEHOHTgxOPftAL5i" name="Overview-GameFlow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-2" parent="1" style="swimlane;whiteSpace=wrap;html=1;spacingLeft=30;" value="facto-loop-miner&#39;s Navigator" vertex="1">
          <mxGeometry height="170" width="320" x="500" y="620" as="geometry" />
        </mxCell>
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-3" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Destination of Everything" vertex="1">
          <mxGeometry height="160" width="300" x="70" y="730" as="geometry" />
        </mxCell>
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-4" parent="W8vjA8FMr1zbrEZ6Sggi-3" style="shape=image;verticalLabelPosition=middle;labelBackgroundColor=default;verticalAlign=middle;aspect=fixed;imageAspect=0;image=data:image/png,;labelPosition=right;align=left;imageBorder=none;shadow=0;imageBackground=none;html=1;" value="&lt;div&gt;&lt;span style=&quot;color: rgb(106, 168, 79);&quot;&gt;Assembler &lt;/span&gt;consumes&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot;&gt;Input Products &lt;/span&gt;and time&amp;nbsp;&lt;/div&gt;to create a&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot;&gt;New Product&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="120" x="10" y="30" as="geometry" />
        </mxCell>
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-5" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;" value="The Game Factorio" vertex="1">
          <mxGeometry height="270" width="430" x="110" as="geometry" />
        </mxCell>
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-6" parent="W8vjA8FMr1zbrEZ6Sggi-5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;div&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot; id=&quot;docs-internal-guid-6a9190fd-7fff-2835-ede6-03561adc55a1&quot;&gt;In the game Factorio, you combine various &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot; id=&quot;docs-internal-guid-6a9190fd-7fff-2835-ede6-03561adc55a1&quot;&gt;Products&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot; id=&quot;docs-internal-guid-6a9190fd-7fff-2835-ede6-03561adc55a1&quot;&gt; in &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; color: rgb(106, 168, 79);&quot;&gt;Assemblers &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;to create &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot;&gt;New Products&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;. These products have progressively more complex inputs that form a large tree. Ultimately you build a &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(191, 144, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Rocket &lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;to leave the planet, winning the game&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;The world contains Ore Patches you mine to obtain&amp;nbsp;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;Iron Ore, Copper Ore, Coal, Stone, Water&lt;/span&gt;, and more.&amp;nbsp;You process into an &lt;span style=&quot;color: light-dark(rgb(191, 144, 0), rgb(191, 144, 0));&quot;&gt;Bootstrap Product &lt;/span&gt;kicking off the above chain&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;The puzzle is how to best deliver resources around the map. At scale things problems become complicated spaghetti which is fun. There&#39;s also Enemies (disabled) you fight for survival.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="390" x="30" as="geometry" />
        </mxCell>
        <mxCell id="W8vjA8FMr1zbrEZ6Sggi-7" edge="1" parent="1" source="W8vjA8FMr1zbrEZ6Sggi-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="W8vjA8FMr1zbrEZ6Sggi-26" value="">
