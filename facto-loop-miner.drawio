  <diagram id="LGSMRBu_Ua5h-WvA0GxI" name="Overview-Workflow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U1lPFQ3D8LXFodngDmoB-2" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=23;" value="High Level Workflow" vertex="1">
          <mxGeometry height="720" width="680" x="85" y="220" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-3" parent="U1lPFQ3D8LXFodngDmoB-2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;Game starts as a large empty map of &lt;span style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;Ore Patches&lt;/span&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt; &lt;/span&gt;and Lakes&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;Input is only raw positions and Entity namef&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;We need to identify where &lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;Ore Patches &lt;/span&gt;and Lakes are&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;We need to calculate the ideal rail paths between &lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;Ore Patches&lt;/span&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt; &lt;/span&gt;and &lt;b&gt;Base&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;We need to calculate the ideal &lt;b&gt;Base &lt;/b&gt;design to win the game the best&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;We need to define infrastructure to model and interact with Factorio&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="500" y="20" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-5" edge="1" parent="U1lPFQ3D8LXFodngDmoB-2" source="U1lPFQ3D8LXFodngDmoB-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;endFill=0;" target="U1lPFQ3D8LXFodngDmoB-8" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="135" y="290" />
              <mxPoint x="135" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-6" parent="U1lPFQ3D8LXFodngDmoB-2" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" value="Import active game" vertex="1">
          <mxGeometry height="60" width="150" x="70" y="220" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-7" parent="U1lPFQ3D8LXFodngDmoB-2" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Recreate all&amp;nbsp;&lt;/div&gt;&lt;div&gt;game Entities we want to place&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="140" y="580" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-8" parent="U1lPFQ3D8LXFodngDmoB-2" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;In-game&amp;nbsp;&lt;/div&gt;&lt;div&gt;Data Export&amp;nbsp;mod&lt;/div&gt;&lt;div&gt;(raw positions)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="150" x="60" y="300" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-9" parent="U1lPFQ3D8LXFodngDmoB-2" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Ore patches&lt;/div&gt;&lt;div&gt;(raw positions&amp;gt; groups)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="60" y="370" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-10" parent="U1lPFQ3D8LXFodngDmoB-2" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Group water patches&lt;/div&gt;&lt;div&gt;(todo)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-11" parent="U1lPFQ3D8LXFodngDmoB-2" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#FF0000;" value="Build Rail Network" vertex="1">
          <mxGeometry height="60" width="150" x="290" y="220" as="geometry" />
        </mxCell>
        <mxCell id="U1lPFQ3D8LXFodngDmoB-12" parent="U1lPFQ3D8LXFodngDmoB-2" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Create&amp;nbsp;&lt;/div&gt;&lt;div&gt;Rail&amp;nbsp;Model&lt;/div&gt;" vertex="1">
